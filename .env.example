# Connection profile: local | docker
Database__ConnectionProfile=local

Kestrel__Endpoints__Https__Url=https://+:5001

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+
ASPNETCORE_HTTPS_PORT=5001
KESTREL_CERT_PASSWORD=
ASPNETCORE_Kestrel__Certificates__Default__Password=
ASPNETCORE_Kestrel__Certificates__Default__Path=/https/localhost.pfx

SA_PASSWORD=
REDIS_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# Docker network endpoints (profile=docker)
ConnectionStrings__DefaultDockerDbConnection=Server=sql_server2022,1433;Database=FashionClothesAndTrendsDB;User Id=sa;Password=;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__Redis=redis:6379,password=,abortConnect=false

# Host machine endpoints (profile=local)
ConnectionStrings__DefaultLocalDbConnection=Server=(localdb)\MSSQLLocalDB;Database=FashionClothesAndTrendsDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# ConnectionStrings__DefaultLocalDbConnection=Server=(localdb)\MSSQLLocalDB;Database=FashionClothesAndTrendsDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__RedisLocalDb=localhost:6379,abortConnect=false

Token__Key=
Token__Issuer=https://localhost:5001
Token__Audience=https://localhost:5001

CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

StripeSettings__PublishableKey=
StripeSettings__SecretKey=
StripeSettings__WhSecret=

Cors__AllowedOrigins__0=https://localhost:4200

# Angular client port (dev: ng serve, prod: nginx)
CLIENT_PORT=4200
CLIENT_HTTP_PORT=80
