root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,md,sln,props,targets,xml,config}]
indent_size = 2

[*.{sh,ps1}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

# Binary files - no formatting
[*.{pfx,pem,cer,crt,key,jks,p12,p7b}]
insert_final_newline = false
end_of_line = unset
charset = unset
trim_trailing_whitespace = false

[certs/**]
insert_final_newline = false
end_of_line = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
